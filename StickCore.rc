            VALUE "OriginalFilename", "StickCore.exe"
            VALUE "ProductName", "StickCore Studio"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
