<RCC>
  <qresource prefix="/anim">
    <file alias="satin.gif">media/anim/satin.gif</file>
    <file alias="fill.gif">media/anim/fill.gif</file>
    <file alias="underlay.gif">media/anim/underlay.gif</file>
    <file alias="monogram.gif">media/anim/monogram.gif</file>
    <file alias="image.gif">media/anim/image.gif</file>
  </qresource>
  <qresource prefix="/svg">
    <file alias="meflogo.svg">media/meflogoplain.svg</file>
    <file alias="wappen_kiel.svg">assets/wappen_kiel_official.svg</file>
  </qresource>
  <qresource prefix="/logo">
    <file alias="logo.png">media/stickcore_logo.png</file>
    <file alias="badge.png">media/stickcore_badge.png</file>
    <file alias="icon.ico">media/stickcore.ico</file>
  </qresource>
</RCC>
